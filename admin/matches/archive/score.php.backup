<?php
/**
 * Match Scoring Interface - Admin Panel
 * 
 * Ball-by-ball scoring interface for live matches
 * Complete implementation per PROJECT_SPECIFICATION.md Section 7.1
 */

require_once __DIR__ . '/../../includes/bootstrap.php';
require_once __DIR__ . '/../../includes/session.php';
require_once __DIR__ . '/../../includes/utils.php';
require_once __DIR__ . '/../includes/sidebar.php';

// Allow both admin and scorer roles
if (!isLoggedIn()) {
    header('Location: ' . adminUrl('login.php'));
    exit;
}

$matchId = (int)getQuery('id', 0);
$isScorer = (getSession('role') === 'scorer');
$redirectUrl = $isScorer ? adminUrl('scorer/index.php') : adminUrl('matches/');

if (!$matchId) {
    header('Location: ' . $redirectUrl);
    exit;
}

$matchModel = new MatchModel();
// Force fresh fetch from database (don't use cache)
$match = $matchModel->getById($matchId);

if (!$match) {
    header('Location: ' . $redirectUrl);
    exit;
}

// Only allow scoring for live matches
if ($match['state'] !== 'live') {
    if ($isScorer) {
        header('Location: ' . adminUrl('scorer/index.php'));
    } else {
        header('Location: ' . adminUrl('matches/view.php?id=' . $matchId));
    }
    exit;
}

// Force refresh match data if cache-busting parameter is present
if (getQuery('_t')) {
    // Clear any potential caching and force fresh database read
    $refreshedMatch = $matchModel->getById($matchId);
    if ($refreshedMatch) {
        $match = $refreshedMatch;
    }
    // If refresh fails, keep using original $match
}

// Ensure match exists (double-check after potential refresh)
if (!$match) {
    header('Location: ' . $redirectUrl);
    exit;
}

// Get teams
$teamModel = new Team();
$teams = $teamModel->getAll();

// Get players for both teams - filter by player_appearances for this match
$playerModel = new Player();
$db = Database::getInstance()->getConnection();

// Determine current innings before using it
$currentInnings = $match['current_innings'] ?? 1;

// Get batting team players (from player_appearances)
$battingTeamId = getBattingTeam($match, $currentInnings);
$bowlingTeamId = ($battingTeamId == $match['team1_id']) ? $match['team2_id'] : $match['team1_id'];

// Get players from player_appearances for this match (including guests)
$battingTeamPlayersSql = "SELECT DISTINCT p.player_id, p.name, p.batting_hand, p.bowling_style, COALESCE(pa.is_guest, 0) as is_guest
                         FROM players p
                         INNER JOIN player_appearances pa ON p.player_id = pa.player_id
                         WHERE pa.match_id = :match_id AND (pa.team_id = :team_id OR pa.is_guest = 1)
                         ORDER BY COALESCE(pa.is_guest, 0) ASC, p.name ASC";
$battingStmt = $db->prepare($battingTeamPlayersSql);
$battingStmt->execute(['match_id' => $matchId, 'team_id' => $battingTeamId]);
$battingTeamPlayers = $battingStmt->fetchAll();

// Get bowling team players (including guests)
$bowlingTeamPlayersSql = "SELECT DISTINCT p.player_id, p.name, p.batting_hand, p.bowling_style, COALESCE(pa.is_guest, 0) as is_guest
                         FROM players p
                         INNER JOIN player_appearances pa ON p.player_id = pa.player_id
                         WHERE pa.match_id = :match_id AND (pa.team_id = :team_id OR pa.is_guest = 1)
                         ORDER BY COALESCE(pa.is_guest, 0) ASC, p.name ASC";
$bowlingStmt = $db->prepare($bowlingTeamPlayersSql);
$bowlingStmt->execute(['match_id' => $matchId, 'team_id' => $bowlingTeamId]);
$bowlingTeamPlayers = $bowlingStmt->fetchAll();

// For backward compatibility, also set team1Players and team2Players
$team1Players = ($battingTeamId == $match['team1_id']) ? $battingTeamPlayers : $bowlingTeamPlayers;
$team2Players = ($battingTeamId == $match['team1_id']) ? $bowlingTeamPlayers : $battingTeamPlayers;

// Get current match state
$eventModel = new Event();
$events = $eventModel->getByMatch($matchId);

// Get dismissed players for current innings (to exclude from new batsman dropdown)
$dismissedPlayerIds = [];
$currentStrikerId = null;
$currentNonStrikerId = null;
$currentBowlerId = null;

// Run stats calculator to ensure DB is up to date
require_once __DIR__ . '/../../classes/StatsCalculator.php';
$statsCalculator = new StatsCalculator();
$statsCalculator->updateMatchStats($matchId);

// Get all events for current innings to find dismissed players and current batsmen
$currentInningsEvents = [];
$currentScore = 0;
$currentWickets = 0;
$legalBalls = 0;

foreach ($events as $event) {
    $payload = json_decode($event['payload_json'] ?? '{}', true);
    $eventInnings = (int)($payload['innings'] ?? 1);
    
    if ($eventInnings == $currentInnings) {
        $currentInningsEvents[] = $event;
        
        // Calculate Score & Wickets
        $type = $payload['type'] ?? '';
        $runs = (int)($payload['runs'] ?? 0);
        $extraType = $payload['extra_type'] ?? '';
        
        if ($type === 'run') {
            $currentScore += $runs;
            $legalBalls++;
        } elseif ($type === 'extra') {
            $currentScore += $runs;
            if ($extraType !== 'wide' && $extraType !== 'no-ball') {
                $legalBalls++;
            }
        } elseif ($type === 'wicket') {
            $currentWickets++;
            $legalBalls++;
        }
        
        // Track dismissed players (wickets)
        if (($payload['type'] ?? '') === 'wicket' && isset($payload['striker_id'])) {
            $dismissedPlayerIds[] = (int)$payload['striker_id'];
        }
        
        // Track current batsmen and bowler (from last run/ball event)
        if (($payload['type'] ?? '') === 'run' || ($payload['type'] ?? '') === 'extra' || ($payload['type'] ?? '') === 'wicket') {
            if (isset($payload['striker_id'])) {
                $currentStrikerId = (int)$payload['striker_id'];
            }
            if (isset($payload['non_striker_id'])) {
                $currentNonStrikerId = (int)$payload['non_striker_id'];
            }
            if (isset($payload['bowler_id'])) {
                $currentBowlerId = (int)$payload['bowler_id'];
            }
        }
        
        // Initialize UI with current selections
        // This JavaScript code cannot be executed directly in PHP.
        // It should be placed in a <script> block in the HTML part of the document.
        // For the purpose of this edit, it's inserted as a comment to maintain PHP syntax.
        /*
        if (document.getElementById('striker').value) updateStriker();
        if (document.getElementById('non-striker').value) updateNonStriker();
        if (document.getElementById('bowler').value) updateBowler();
        */
        if (($payload['type'] ?? '') === 'wicket' && isset($payload['new_batsman_id'])) {
            $currentStrikerId = (int)$payload['new_batsman_id'];
        }
        
        // Track retired hurt replacement
        if (($payload['type'] ?? '') === 'retired_hurt' && isset($payload['replacement_player_id'])) {
            $currentStrikerId = (int)$payload['replacement_player_id'];
        }
    }
}

// Fetch detailed player stats for JS
$db = Database::getInstance()->getConnection();
$battingStats = $db->prepare("SELECT * FROM batting_stats WHERE match_id = ?");
$battingStats->execute([$matchId]);
$bowlingStats = $db->prepare("SELECT * FROM bowling_stats WHERE match_id = ?");
$bowlingStats->execute([$matchId]);

$jsPlayerStats = ['batsmen' => [], 'bowlers' => []];
while ($row = $battingStats->fetch(PDO::FETCH_ASSOC)) {
    $jsPlayerStats['batsmen'][$row['player_id']] = [
        'runs' => (int)$row['runs'],
        'balls' => (int)$row['balls'],
        'fours' => (int)$row['fours'],
        'sixes' => (int)$row['sixes']
    ];
}
while ($row = $bowlingStats->fetch(PDO::FETCH_ASSOC)) {
    $jsPlayerStats['bowlers'][$row['player_id']] = [
        'runs' => (int)$row['runs'],
        'balls' => (int)$row['balls'],
        'wickets' => (int)$row['wickets'],
        'overs' => (float)$row['overs']
    ];
}

// Remove duplicates
$dismissedPlayerIds = array_unique($dismissedPlayerIds);

// Filter available players for new batsman (exclude dismissed and current batsmen)
$availableBatsmen = [];
foreach ($battingTeamPlayers as $player) {
    $playerId = (int)$player['player_id'];
    
    // Skip if dismissed
    if (in_array($playerId, $dismissedPlayerIds)) {
        continue;
    }
    
    // Skip if currently batting (striker or non-striker)
    if ($playerId == $currentStrikerId || $playerId == $currentNonStrikerId) {
        continue;
    }
    
    $availableBatsmen[] = $player;
}

// Calculate actual team sizes (for local cricket format support)
$battingTeamSize = count($battingTeamPlayers);
$bowlingTeamSize = count($bowlingTeamPlayers);

// Calculate maximum wickets (team size - 1, since at least 1 batsman must remain)
$maxWickets = max(1, $battingTeamSize - 1);

// Determine current batting team (already calculated above, but set team names here)
$battingTeam = $battingTeamId == $match['team1_id'] ? $match['team1_name'] : $match['team2_name'];
$bowlingTeam = $battingTeamId == $match['team1_id'] ? $match['team2_name'] : $match['team1_name'];

// Calculate first innings total for target calculation using helper
$firstInningsTotal = 0;
if ($currentInnings == 2) {
    $scoreData = calculateMatchScore($matchId, 1);
    if ($scoreData && isset($scoreData['innings1'])) {
        $firstInningsTotal = $scoreData['innings1']['runs'];
    }
}

// Get success/error messages from session (after redirect from change-innings.php)
$successMessage = '';
$errorMessage = '';
if (isset($_SESSION['success'])) {
    $successMessage = $_SESSION['success'];
    unset($_SESSION['success']);
}
if (isset($_SESSION['error'])) {
    $errorMessage = $_SESSION['error'];
    unset($_SESSION['error']);
}

// Calculate batting team ID for JavaScript config
$battingTeamId = getBattingTeam($match, $currentInnings);

// Debug: Log current innings value (only if match exists)
if ($match) {
    error_log('Score Page: match_id=' . $matchId . ', current_innings=' . ($match['current_innings'] ?? 'NULL') . ', state=' . ($match['state'] ?? 'NULL') . ', batting_team_size=' . $battingTeamSize . ', max_wickets=' . $maxWickets);
}
?>
