{
  "name": "cricapp/cricapp",
  "description": "Cricket Scoring Application - Simple, lightweight scoring app for local teams",
  "type": "project",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "CricApp\\": "classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CricApp\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
